# Copy to .env. Never commit the real file.
# Paper / mock runs do not need exchange keys.
# If XAI_API_KEY is empty, the desk uses deterministic rules and says so in the log.

XAI_API_KEY=

# DeepSeek (https://api.deepseek.com). Used when llm.provider is deepseek,
# or when provider is auto and the xAI key is missing or rejected.
DEEPSEEK_API_KEY=

# Bybit Demo Trading (https://api-demo.bybit.com). Used when exchange.mode is demo.
# This is not the testnet and not the real mainnet.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Bybit spot testnet (https://testnet.bybit.com). Used only when mode: testnet
# and exchange.mode: testnet.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Binance spot testnet (https://testnet.binance.vision). Used only when
# mode: testnet and exchange.name: binance.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional OpenAI-compatible proxy (for example freellmapi) for the volume
# prefilter only. Ignored unless llm.fallback.enabled is true.
# FALLBACK_API_KEY=

# Mainnet keys are intentionally not listed. Orders on mainnet also require
# mode: mainnet and allow_mainnet: true. The process then reads
# DEXBOT_MAINNET_API_KEY and DEXBOT_MAINNET_API_SECRET.
