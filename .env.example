# Copy to .env and fill in. Never commit .env.
# Linux: chmod 600 .env
# Windows (Administrator): icacls .env /inheritance:r /grant:r "SYSTEM:(R)" "%USERNAME%:(R,W)"

# paper | demo | testnet | mainnet
# Overrides mode in config/default.yaml. Use demo on the Bybit demo account.
DEXBOT_MODE=demo

# Set to true only together with mode: mainnet. Leave empty otherwise.
DEXBOT_ALLOW_MAINNET=

# Optional JSON log file. Docker Compose sets /app/data/logs/dexbot.log.
# Windows scripts set C:\dexbot\data\logs\dexbot.log when this is empty.
# DEXBOT_LOG_FILE=

# Optional absolute paths. If unset, paths are relative to the working directory
# (data\journal.sqlite and data\KILL). On Windows that directory is C:\dexbot.
# DEXBOT_JOURNAL=C:\dexbot\data\journal.sqlite
# DEXBOT_KILL_FILE=C:\dexbot\data\KILL

# xAI. Probed first when llm.provider is auto. Live web + X search.
XAI_API_KEY=

# DeepSeek (https://api.deepseek.com). Used when provider is deepseek,
# or when auto and the xAI key is missing or rejected.
DEEPSEEK_API_KEY=

# Bybit Demo Trading (https://api-demo.bybit.com). Not testnet, not real mainnet.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Bybit spot testnet. Only when mode and exchange.mode are testnet.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Binance spot testnet. Only when mode is testnet and exchange.name is binance.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# OpenAI-compatible proxy for the volume prefilter only.
# Ignored unless llm.fallback.enabled is true.
FALLBACK_API_KEY=

# Real-money keys. Also require mode: mainnet and allow_mainnet: true.
# Leave empty.
DEXBOT_MAINNET_API_KEY=
DEXBOT_MAINNET_API_SECRET=
